      "text": {"en": "If x + 5 = 12, what is the value of x?", "hi": "यदि x + 5 = 12 है, तो x का मान क्या है?"},
      "options": [
        {"key": "a", "text": {"en": "5", "hi": "5"}},
        {"key": "b", "text": {"en": "6", "hi": "6"}},
        {"key": "c", "text": {"en": "7", "hi": "7"}},
        {"key": "d", "text": {"en": "8", "hi": "8"}}
      ],
      "correctKey": "c",
      "explanation": {"en": "x = 12 − 5 = 7.", "hi": "x = 12 − 5 = 7।"}
    },
