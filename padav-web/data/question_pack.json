    {
      "id": "q_math_003", "subjectId": "math", "topic": {"en": "Speed and Distance", "hi": "चाल और दूरी"}, "difficulty": "easy",
      "text": {"en": "A train travels at 60 km/h. How far does it go in 2.5 hours?", "hi": "एक रेलगाड़ी 60 किमी/घंटा की चाल से चलती है। 2.5 घंटे में वह कितनी दूरी तय करेगी?"},
      "options": [
        {"key": "a", "text": {"en": "120 km", "hi": "120 किमी"}},
        {"key": "b", "text": {"en": "150 km", "hi": "150 किमी"}},
        {"key": "c", "text": {"en": "160 km", "hi": "160 किमी"}},
        {"key": "d", "text": {"en": "180 km", "hi": "180 किमी"}}
      ],
      "correctKey": "b",
      "explanation": {"en": "Distance = speed × time = 60 × 2.5 = 150 km.", "hi": "दूरी = चाल × समय = 60 × 2.5 = 150 किमी।"}
    },
