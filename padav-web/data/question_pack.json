    {
      "id": "q_math_001", "subjectId": "math", "topic": {"en": "Percentages", "hi": "प्रतिशत"}, "difficulty": "easy",
      "text": {"en": "What is 15% of 200?", "hi": "200 का 15% कितना होता है?"},
      "options": [
        {"key": "a", "text": {"en": "20", "hi": "20"}},
        {"key": "b", "text": {"en": "25", "hi": "25"}},
        {"key": "c", "text": {"en": "30", "hi": "30"}},
        {"key": "d", "text": {"en": "35", "hi": "35"}}
      ],
      "correctKey": "c",
      "explanation": {"en": "15% of 200 = 15 × 200 / 100 = 30.", "hi": "200 का 15% = 15 × 200 / 100 = 30।"}
    },
