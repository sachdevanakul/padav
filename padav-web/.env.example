APP_NAME=Padav
ENVIRONMENT=development
DEBUG=false
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (>= 32 chars) when ENVIRONMENT=production. In development an ephemeral key is used if empty.
SECRET_KEY=
DATABASE_URL=sqlite:///./padav.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- optional hardening knobs (defaults shown) ---
# ALLOWED_HOSTS=padav.example.com      # required in production
# ENABLE_DOCS=false                    # /docs is off in production by default
# SEED_ON_STARTUP=false                # starter catalogue; off in production by default
# AUTH_RATE_LIMIT_PER_MINUTE=20
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
# DEV_HOST=127.0.0.1                   # use 0.0.0.0 only to test from another device
